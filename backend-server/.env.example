# ====================================================================
# SURAKSHA AI — Backend Configuration & Security Environment Template
# ====================================================================

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_db
USE_MOCK_FALLBACK=true

# Security & Encryption
MEDICAL_CACHE_SECRET=  # 32-byte url-safe base64 key or auto-generated
MEDICAL_DATA_TTL_SECONDS=900
AUDIT_LOG_ENABLED=true
RATE_LIMIT_BACKEND=memory  # 'memory' or 'redis'

# Health Provider / ABDM Sandbox Integration
HEALTH_PROVIDER_MODE=sandbox  # 'sandbox' or 'live'
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_TIMEOUT_SECONDS=3.0

# APAAR / National Identity Integration
APAAR_INTEGRATION_MODE=sandbox  # 'sandbox' or 'live'

# Authority Governance & RBAC Authentication
AUTHORITY_DEMO_MODE=true  # Set to 'false' in production to mandate X-Authority-Role / Bearer token
AUTHORITY_API_KEYS=dev-auth-key-2026,gsdma-secure-token
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
